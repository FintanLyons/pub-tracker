# dependencies
node_modules/
.venv/
.venv-*/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
scripts/.env

# EAS / signing (never commit)
credentials.json
credentials/

# Firebase Android client config (contains API keys; bundle locally / CI secret — not in git)
google-services.json

# Supabase CLI cache
supabase/.temp/

# Tier A website fetch extractions (generated; can be large)
data/tier_a_extractions/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
