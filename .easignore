supabase/.temp/

# TS incremental cache
*.tsbuildinfo

# Pipeline only (SQL, Python, CSV enrichment) — not imported by the app
scripts/

# Data pipeline CSVs + unused large geo (do NOT use data/** — negation cannot re-include for EAS).
# Metro bundles only: data/geo/london_postcode_*.min.json, data/postcode_district_display_names.json
data/*.csv
data/data_list*
data/tier_a*
data/geo/london_boroughs*
data/geo/london_wards*
data/geo/*.geojson
