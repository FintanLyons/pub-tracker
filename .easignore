# Dependencies / local tooling
node_modules/
.venv/

# Expo local state
.expo/
dist/
web-build/
expo-env.d.ts

# Native / build artifacts
.kotlin/
*.orig.*
/ios
/android

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS noise
.DS_Store

# Local env files
.env*.local
.env
scripts/.env

# EAS / signing secrets
credentials.json
credentials/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Keep Firebase Android config in EAS upload context
!google-services.json

