# --- Client-safe (bundled into the app via EXPO_PUBLIC_ prefix) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Email sign-up confirmation opens this URL (whitelist the same URL in Supabase → Auth → URL Configuration).
# EXPO_PUBLIC_EMAIL_CONFIRM_REDIRECT_URL=https://fintanlyons.com/pub
# Optional: if your dashboard function slug is not presign-r2-upload (404 fix)
# EXPO_PUBLIC_SUPABASE_PRESIGN_FUNCTION=dynamic-responder

# Unique app IDs for iOS (bundle identifier) and Android (applicationId).
# Use reverse-DNS you control, e.g. com.yourname.pubtracker — required before store submission.
# EXPO_PUBLIC_IOS_BUNDLE_ID=com.yourname.pubtracker
# EXPO_PUBLIC_ANDROID_PACKAGE=com.yourname.pubtracker

# Google Sign-In: Web application OAuth client ID from Google Cloud Console.
# The client SECRET goes into Supabase dashboard only — never here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com


# --- Server-side only (scripts, NOT bundled into the app) ---
# Python scripts (backfill_spatial_postcodes_from_latlon.py, fix_pub_areas.py, …) use:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-jwt   # same value as below; scripts read SUPABASE_KEY
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CX=your-google-custom-search-id
OPENAI_API_KEY=your-openai-api-key
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://your-r2-public-url

# --- Supabase Edge Function: presign-r2-upload (set in Supabase Dashboard → Edge Functions → Secrets, not in Expo) ---
# Same R2_* keys as above + optional R2_ALLOW_CLIENT_PUB_UPLOAD=true
# Deploy from repo root: supabase functions deploy presign-r2-upload
# Local env file for CLI: supabase secrets set --env-file ./supabase/.env.functions.local
